# Local environment variables for OpenClaw
# WARNING: Do NOT paste secrets into chat. Keep this file local and git-ignored.
# Fill these values with your real credentials before restarting the services.

TELEGRAM_BOT_TOKEN=
OLLAMA_URL=
MODEL=

# Example values (do NOT use in production):
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# OLLAMA_URL=http://localhost:11434
# MODEL=llama3:8b
